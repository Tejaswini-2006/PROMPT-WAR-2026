# PaisaPilot AI - Environment Configuration
# Copy this file to .env.local for local development

# Google Gemini API Key (Server-side ONLY - NEVER exposed to browser client)
# Obtain from https://aistudio.google.com/app/apikey
# If omitted or invalid, PaisaPilot AI seamlessly runs on its robust deterministic finance engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
